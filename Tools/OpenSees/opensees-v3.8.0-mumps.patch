+// JOB=-1 resets every ICNTL to its default, so the controls are set after it, not in the constructor
+void
+MumpsSolver::setControls(void)
+{
+  // No outputs
+  id.ICNTL(1)=-1; id.ICNTL(2)=-1; id.ICNTL(3)=-1; id.ICNTL(4)=0;
+
+  id.ICNTL(7) = icntl7;
+  id.ICNTL(14) = icntl14;
+  id.ICNTL(16) = numThreads;
+
+  // KEEP(401): tree parallelism (L0-OpenMP), the leaves of the elimination tree factored on
+  // separate threads. Off by default in MUMPS 5.5; from 5.6 it is ICNTL(48), on by default.
+  if (numThreads != 1)
+    id.keep[400] = 1;
 }
 
