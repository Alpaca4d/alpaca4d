diff --git a/CMakeLists.txt b/CMakeLists.txt
index 78e499a2b..2052e1775 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -702,6 +702,38 @@ target_link_libraries(OpenSees
   Eigen3::Eigen
 )
 
+#
+# system Mumps in the single-process interpreter: sequential MUMPS (libseq, no MPI)
+# built with OpenMP, so one process factorises on several cores.
+#   -DMUMPS_SEQ_DIR=<install prefix of MUMPS built with -Dparallel=OFF -Dopenmp=ON>
+#
+
+if (DEFINED MUMPS_SEQ_DIR)
+    # the static libraries by name, as for OpenSeesSP/MP, so MUMPS uses the LAPACK OpenSees links
+    set(MUMPS_SEQ_LIBRARIES "")
+    foreach(lib dmumps mumps_common pord mpiseq)
+        find_library(MUMPS_SEQ_${lib} NAMES ${lib} PATHS ${MUMPS_SEQ_DIR}/lib NO_DEFAULT_PATH REQUIRED)
+        list(APPEND MUMPS_SEQ_LIBRARIES ${MUMPS_SEQ_${lib}})
+    endforeach()
+
+    target_sources(OpenSees PRIVATE
+      ${OPS_SRC_DIR}/system_of_eqn/linearSOE/mumps/MumpsSOE.cpp
+      ${OPS_SRC_DIR}/system_of_eqn/linearSOE/mumps/MumpsSolver.cpp
+    )
+    target_include_directories(OpenSees PRIVATE ${MUMPS_SEQ_DIR}/include)
+    target_compile_definitions(OpenSees PRIVATE _MUMPS_SEQUENTIAL)
+    target_link_libraries(OpenSees ${MUMPS_SEQ_LIBRARIES} ${LAPACK_LIBRARIES})
+
+    if (APPLE)
+        # gfortran's OpenMP runtime, linked statically like libgfortran above
+        execute_process(COMMAND gfortran --print-file-name=libgomp.a OUTPUT_VARIABLE GOMP_STATIC OUTPUT_STRIP_TRAILING_WHITESPACE)
+        target_link_libraries(OpenSees "${GOMP_STATIC}")
+    else()
+        find_package(OpenMP REQUIRED COMPONENTS Fortran)
+        target_link_libraries(OpenSees OpenMP::OpenMP_Fortran)
+    endif()
+endif()
+
 
